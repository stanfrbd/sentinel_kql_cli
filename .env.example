SENTINEL_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SENTINEL_RESOURCE_GROUP=my-resource-group
SENTINEL_WORKSPACE=my-log-analytics-workspace
# Optional — workspace GUID from Azure portal (Properties → Workspace ID).
# If set, skips the automatic resolution step (faster startup).
SENTINEL_WORKSPACE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Set to false if behind a corporate proxy that performs SSL inspection.
# SSL_VERIFY=false